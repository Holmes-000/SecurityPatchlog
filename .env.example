# Port SecPatchlog listens on
PORT=4400

# The address CI / the triage script uses to reach SecPatchlog, e.g. https://security.example.com
# Used for the URLs shown when you create a project or rotate a key. Empty = the address in your browser.
PUBLIC_URL=

# Where the SQLite database lives (relative to this folder)
DB_PATH=data/security.db

# Secret used to sign login sessions. If empty, one is generated and stored in the database.
SESSION_SECRET=

# Optional: create the first admin automatically on first start (otherwise use the setup page)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Default minimum days between scans per project (GET /api/should-scan returns 0 until it has passed).
# Admins can override it per project on the Projects page. 0 = always scan.
SCAN_INTERVAL_DAYS=7

# Set to 1 when running behind a reverse proxy (nginx, load balancer) so client IPs are correct
TRUST_PROXY=0

# Optional: SMTP for emailing new users their sign-in details. Mail is off while SMTP_HOST is empty.
SMTP_HOST=
# 587 = STARTTLS (usual), 465 = TLS from the start. SMTP_SECURE defaults to 1 on port 465, else 0.
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. "SecPatchlog <security@example.com>". Defaults to SMTP_USER.
MAIL_FROM=
